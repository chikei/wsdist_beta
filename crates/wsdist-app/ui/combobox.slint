// Adapted from Slint 1.16 Fluent ComboBox and ListItem rendering.

import { ComboBoxBase } from "builtin:/common/combobox-base.slint";
import { FluentFontSettings, FluentPalette, Icons } from "builtin:/fluent/styling.slint";
import { FocusBorder, MenuBorder } from "builtin:/fluent/components.slint";
import { ScrollView } from "builtin:/fluent/scrollview.slint";

component CompactComboOption {
    in property <string> value;
    in property <bool> is-selected;
    in property <bool> enabled;
    in property <int> index;
    in property <length> text-inset;
    callback activated();

    min-width: 0px;
    horizontal-stretch: 1;
    vertical-stretch: 0;
    accessible-role: list-item;
    accessible-label: root.value;
    accessible-enabled: root.enabled;
    accessible-item-selectable: true;
    accessible-item-selected: root.is-selected;
    accessible-item-index: root.index;

    states [
        pressed when touch-area.pressed : {
            background.background: root.is-selected ? FluentPalette.subtle-secondary : FluentPalette.subtle-tertiary;
        }
        hover when touch-area.has-hover : {
            text.color: FluentPalette.text-secondary;
            background.background: root.is-selected ? FluentPalette.subtle-tertiary : FluentPalette.subtle-secondary;
        }
        is-selected when root.is-selected : {
            background.background: FluentPalette.subtle-secondary;
        }
    ]

    background := Rectangle {
        y: 2px;
        width: root.width;
        height: max(0px, root.height - 4px);
        border-radius: 4px;

        Rectangle {
            x: 0px;
            y: (parent.height - self.height) / 2;
            width: 3px;
            height: root.is-selected ? min(16px, parent.height) : 0px;
            background: FluentPalette.accent-background;
            border-radius: 2px;
        }
    }

    text := Text {
        x: root.text-inset;
        width: max(0px, root.width - 2 * root.text-inset);
        height: root.height;
        text: root.value;
        color: FluentPalette.control-foreground;
        font-size: FluentFontSettings.body.font-size;
        font-weight: FluentFontSettings.body.font-weight;
        vertical-alignment: center;
        horizontal-alignment: left;
        overflow: elide;
        accessible-role: none;

        animate color { duration: 200ms; }
    }

    touch-area := TouchArea {
        enabled: root.enabled;
        clicked => { root.activated(); }
    }
}

export component CompactComboBox {
    in property <[string]> model <=> base.model;
    in property <bool> enabled <=> base.enabled;
    out property <bool> has-focus <=> base.has-focus;
    in-out property <int> current-index <=> base.current-index;
    in-out property <string> current-value <=> base.current-value;
    callback selected <=> base.selected;

    private property <length> text-inset: 11px;
    private property <length> popup-padding: 4px;
    private property <length> popup-scroll-y;
    private property <int> visible-items: min(6, root.model.length);

    min-width: max(160px, layout.min-height);
    min-height: max(32px, layout.min-height);
    horizontal-stretch: 1;
    vertical-stretch: 0;
    forward-focus: base;

    accessible-role: combobox;
    accessible-enabled: root.enabled;
    accessible-expandable: true;
    accessible-expanded: base.popup-has-focus;
    accessible-value <=> root.current-value;
    accessible-action-expand => { base.show-popup(); }

    // Follow keyboard selection, but do not snap back after an explicit wheel
    // scroll. The viewport includes equal padding above and below its rows.
    function reveal-current-option() {
        if root.current-index >= 0 {
            let top = root.current-index * root.height;
            let bottom = top + root.height;
            let visible-height = root.visible-items * root.height;
            root.popup-scroll-y = -max(0px, min(top, max(-root.popup-scroll-y, bottom - visible-height)));
        }
    }

    changed current-index => {
        if base.popup-has-focus { root.reveal-current-option(); }
    }

    states [
        disabled when !root.enabled : {
            background.background: FluentPalette.control-disabled;
            background.border-color: FluentPalette.border;
            text.color: FluentPalette.text-disabled;
            icon.colorize: FluentPalette.text-disabled;
        }
        pressed when base.pressed : {
            background.background: FluentPalette.control-alt-tertiary;
            background.border-color: FluentPalette.border;
            text.color: FluentPalette.text-secondary;
            icon.colorize: FluentPalette.text-tertiary;
        }
        hover when base.has-hover : {
            background.background: FluentPalette.control-secondary;
        }
    ]

    base := ComboBoxBase {
        width: 100%;
        height: 100%;
        show-popup => {
            if root.enabled {
                root.popup-scroll-y = -max(0, root.current-index - root.visible-items + 1) * root.height;
                popup.show();
            }
        }
        close-popup => { popup.close(); }
    }

    background := Rectangle {
        border-radius: 3px;
        background: FluentPalette.control-background;
        border-width: 1px;
        border-color: FluentPalette.control-border;

        animate border-color { duration: 200ms; }

        layout := HorizontalLayout {
            padding-left: root.text-inset;
            padding-right: root.text-inset;
            spacing: 8px;

            text := Text {
                horizontal-alignment: left;
                vertical-alignment: center;
                font-size: FluentFontSettings.body.font-size;
                font-weight: FluentFontSettings.body.font-weight;
                color: FluentPalette.control-foreground;
                text: root.current-value;
                accessible-role: none;
            }

            icon := Image {
                colorize: FluentPalette.text-secondary;
                width: 12px;
                source: Icons.dropdown;
                y: 2px;
                accessible-role: none;

                animate colorize { duration: 150ms; }
            }
        }
    }

    if root.has-focus && root.enabled : FocusBorder {
        border-radius: background.border-radius;
    }

    popup := PopupWindow {
        x: 0px;
        y: -root.popup-padding;
        width: root.width;
        height: root.visible-items * root.height + 2 * root.popup-padding;
        close-policy: close-on-click-outside;
        forward-focus: inner-fs;

        inner-fs := FocusScope {
            focus-changed-event => { base.popup-has-focus = self.has-focus; }
            key-pressed(event) => { return base.popup-key-handler(event); }

            MenuBorder {
                accessible-role: list;
                accessible-label: root.accessible-label + " options";

                ScrollView {
                    min-width: 0px;
                    min-height: 0px;
                    viewport-width: self.visible-width;
                    viewport-height: root.model.length * root.height + 2 * root.popup-padding;
                    viewport-y <=> root.popup-scroll-y;
                    horizontal-scrollbar-policy: always-off;

                    VerticalLayout {
                        alignment: start;
                        padding: root.popup-padding;

                        for value[index] in root.model : CompactComboOption {
                            value: value;
                            index: index;
                            enabled: root.enabled;
                            is-selected: index == root.current-index;
                            height: root.height;
                            // Include the popup's outer padding in the same
                            // effective text inset as the closed display.
                            text-inset: root.text-inset - root.popup-padding;
                            activated => {
                                base.select(index);
                                popup.close();
                            }
                        }
                    }
                }
            }
        }
    }
}
