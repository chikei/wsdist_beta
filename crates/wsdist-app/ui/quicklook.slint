import { Button, GroupBox, Palette } from "std-widgets.slint";
import { ScrollView } from "scroll.slint";
import { InputRow, InputWidgetKind, GearChoiceRow, GearSlotRow } from "types.slint";
import { ControlEditor, InputGroup } from "controls.slint";
import { GearPanel } from "gear.slint";

export component Quicklook inherits Rectangle {
    in property <[InputRow]> basics;
    in property <[InputRow]> abilities;
    in property <[InputRow]> enemy;
    in property <[InputRow]> whm;
    in property <[InputRow]> food;
    in property <[InputRow]> brd;
    in property <[InputRow]> cor;
    in property <[InputRow]> geo;
    in property <[GearSlotRow]> equipped;
    in property <[GearChoiceRow]> items;
    in property <int> active-slot;
    in property <string> sublevel;
    in property <string> skill-label;
    in property <string> damage;
    in property <string> tp-return;
    in property <string> time-to-ws;
    in property <bool> inputs-enabled: true;

    callback text-edited(string, string);
    callback editing-finished(string, string);
    callback toggled(string, bool);
    callback wheel(string, int);
    callback text-focus(bool);
    callback slot-selected(string, int);
    callback item-selected(string, int);
    callback action(string);
    callback copy(string, string);

    private property <int> focus-count: 0;
    private property <bool> editing-focus: root.inputs-enabled && root.visible && root.focus-count > 0;
    changed editing-focus => { root.text-focus(root.editing-focus); }

    function focus-changed(focused: bool) {
        root.focus-count = max(0, root.focus-count + (focused ? 1 : -1));
    }

    // Enemy and COR models keep the literal INPUT_PRESENTATION row order.
    private property <[string]> enemy-stat-labels: [
        "Evasion:", "Defense:", "Magic Evasion:", "Magic Defense:", "Magic DT%:",
        "Resist Rank:", "VIT:", "AGI:", "INT:", "MND:", "CHR:",
    ];

    min-width: 640px;
    min-height: 120px;
    preferred-height: 800px;

    input-scroll := ScrollView {
        width: root.width;
        height: root.height;
        viewport-width: self.visible-width;
        accessible-role: list;
        accessible-label: "Quicklook content";
        scroll-label: self.accessible-label + " vertical scrollbar";

        VerticalLayout {
            x: 0px;
            width: 688px;
            horizontal-stretch: 0;
            padding-left: 4px;
            padding-right: 4px;
            padding-top: 2px;
            padding-bottom: 2px;
            spacing: 0px;

            HorizontalLayout {
                min-width: 680px;
                max-width: 680px;
                preferred-width: 680px;
                horizontal-stretch: 0;
                spacing: 2px;
                min-height: enemy-group.preferred-height;
                max-height: enemy-group.preferred-height;
                preferred-height: enemy-group.preferred-height;
                vertical-stretch: 0;

                GroupBox {
                    title: "Basic Inputs";
                    content-padding: 0px;
                    min-width: 216px;
                    max-width: 216px;
                    preferred-width: 216px;
                    horizontal-stretch: 0;

                    basics-scroll := ScrollView {
                        min-width: 216px;
                        max-width: 216px;
                        preferred-width: 216px;
                        horizontal-stretch: 0;
                        viewport-width: self.visible-width;
                        accessible-role: list;
                        accessible-label: "Job, spell, weapon skill & TP inputs";
                        scroll-label: self.accessible-label + " vertical scrollbar";

                        VerticalLayout {
                            width: basics-scroll.visible-width;
                            horizontal-stretch: 0;
                            spacing: 0px;
                            for row in root.basics : Rectangle {
                                min-width: basics-scroll.visible-width;
                                max-width: basics-scroll.visible-width;
                                preferred-width: basics-scroll.visible-width;
                                horizontal-stretch: 0;
                                min-height: basic-editor.row-height;
                                max-height: basic-editor.row-height;
                                preferred-height: basic-editor.row-height;
                                vertical-stretch: 0;
                                basic-editor := ControlEditor {
                                    width: parent.width;
                                    horizontal-stretch: 0;
                                    height: parent.height;
                                    control: row;
                                    display-label: row.key == "defaults_subjob_combobox" ? "Subjob (Lv." + root.sublevel + ")" : row.label;
                                    inputs-enabled: root.inputs-enabled;
                                    text-edited(key, value) => { root.text-edited(key, value); }
                                    editing-finished(key, value) => { root.editing-finished(key, value); }
                                    toggled(key, value) => { root.toggled(key, value); }
                                    wheel(key, direction) => { root.wheel(key, direction); }
                                    text-focus(focused) => { root.focus-changed(focused); }
                                }
                            }
                        }
                    }
                }

                InputGroup {
                    title: "Special Toggles";
                    rows: root.abilities;
                    min-width: 180px;
                    max-width: 180px;
                    preferred-width: 180px;
                    min-height: enemy-group.preferred-height;
                    max-height: enemy-group.preferred-height;
                    preferred-height: enemy-group.preferred-height;
                    vertical-stretch: 0;
                    horizontal-stretch: 0;
                    inputs-enabled: root.inputs-enabled;
                    text-edited(key, value) => { root.text-edited(key, value); }
                    editing-finished(key, value) => { root.editing-finished(key, value); }
                    toggled(key, value) => { root.toggled(key, value); }
                    wheel(key, direction) => { root.wheel(key, direction); }
                    text-focus(focused) => { root.focus-changed(focused); }
                }

                enemy-group := GroupBox {
                    title: "Enemy Inputs";
                    content-padding: 0px;
                    min-width: 276px;
                    max-width: 276px;
                    preferred-width: 276px;
                    horizontal-stretch: 0;

                    enemy-scroll := Rectangle {
                        min-width: 276px;
                        max-width: 276px;
                        preferred-width: 276px;
                        horizontal-stretch: 0;
                        min-height: enemy-grid.preferred-height;
                        max-height: enemy-grid.preferred-height;
                        preferred-height: enemy-grid.preferred-height;
                        accessible-role: list;
                        accessible-label: "Enemy Inputs inputs";

                        enemy-grid := GridLayout {
                            width: 276px;
                            height: self.preferred-height;
                            y: 0px;
                            horizontal-stretch: 0;
                            spacing: 0px;
                            for control[index] in root.enemy : ControlEditor {
                                row: index < 8 ? index : index - 6;
                                col: index < 8 ? 0 : 1;
                                colspan: index < 2 ? 2 : 1;
                                control: control;
                                show-label: index >= 2;
                               // editor-height: index < 2 ? 26px : 21px;
                                display-label: index >= 2 ? root.enemy-stat-labels[index - 2] : control.label;
                                label-width: index < 2 ? 0px : index < 8 ? 92px : 36px;
                                min-width: index < 2 ? 276px : index < 8 ? 174px : 102px;
                                max-width: index < 2 ? 276px : index < 8 ? 174px : 102px;
                                preferred-width: index < 2 ? 276px : index < 8 ? 174px : 102px;
                                max-height: self.row-height;
                                horizontal-stretch: 0;
                                inputs-enabled: root.inputs-enabled;
                                text-edited(key, value) => { root.text-edited(key, value); }
                                editing-finished(key, value) => { root.editing-finished(key, value); }
                                toggled(key, value) => { root.toggled(key, value); }
                                wheel(key, direction) => { root.wheel(key, direction); }
                                text-focus(focused) => { root.focus-changed(focused); }
                            }
                        }
                    }
                }
            }

            GroupBox {
                title: "Active Buffs";
                content-padding: 0px;
                min-width: 680px;
                max-width: 680px;
                preferred-width: 680px;
                horizontal-stretch: 0;
                max-height: self.preferred-height;
                vertical-stretch: 0;

                HorizontalLayout {
                    min-width: 680px;
                    max-width: 680px;
                    preferred-width: 680px;
                    horizontal-stretch: 0;
                    spacing: 4px;
                    min-height: max(max(whm-content.preferred-height, brd-content.preferred-height), max(cor-content.preferred-height, geo-content.preferred-height));
                    max-height: self.min-height;
                    preferred-height: self.min-height;
                    vertical-stretch: 0;

                    whm-scroll := ScrollView {
                        min-width: 148px;
                        max-width: 148px;
                        preferred-width: 148px;
                        horizontal-stretch: 0;
                        viewport-width: self.visible-width;
                        accessible-role: list;
                        accessible-label: "White Magic — " + root.skill-label + " inputs";
                        scroll-label: self.accessible-label + " vertical scrollbar";

                        whm-content := VerticalLayout {
                            width: whm-scroll.visible-width;
                            horizontal-stretch: 0;
                            spacing: 0px;
                            for row in root.whm : Rectangle {
                                min-width: whm-scroll.visible-width;
                                max-width: whm-scroll.visible-width;
                                preferred-width: whm-scroll.visible-width;
                                horizontal-stretch: 0;
                                min-height: whm-row.preferred-height;
                                max-height: whm-row.preferred-height;
                                preferred-height: whm-row.preferred-height;
                                vertical-stretch: 0;
                                whm-row := VerticalLayout {
                                    width: parent.width;
                                    height: parent.height;
                                    spacing: 0px;
                                    alignment: start;
                                    if row.key == "defaults_enhancing_skill_entry" && row.visible: Text {
                                        width: whm-scroll.visible-width;
                                        text: root.skill-label;
                                        color: root.inputs-enabled && row.enabled ? Palette.foreground : Palette.foreground.with-alpha(0.55);
                                    }
                                    whm-editor := ControlEditor {
                                        min-width: whm-scroll.visible-width;
                                        max-width: whm-scroll.visible-width;
                                        preferred-width: whm-scroll.visible-width;
                                        horizontal-stretch: 0;
                                        max-height: self.row-height;
                                        control: row;
                                        show-label: row.key != "defaults_enhancing_skill_entry" && row.control-kind != InputWidgetKind.combo;
                                        label-width: row.control-kind == InputWidgetKind.entry ? 68px : 0px;
                                        inputs-enabled: root.inputs-enabled;
                                        text-edited(key, value) => { root.text-edited(key, value); }
                                        editing-finished(key, value) => { root.editing-finished(key, value); }
                                        toggled(key, value) => { root.toggled(key, value); }
                                        wheel(key, direction) => { root.wheel(key, direction); }
                                        text-focus(focused) => { root.focus-changed(focused); }
                                    }
                                }
                            }
                            VerticalLayout {
                                min-width: whm-scroll.visible-width;
                                max-width: whm-scroll.visible-width;
                                preferred-width: whm-scroll.visible-width;
                                horizontal-stretch: 0;
                                spacing: 0px;
                                alignment: start;
                            Text {
                              text: "Active Food";
                            }
                                for row in root.food : ControlEditor {
                                    control: row;
                                    min-width: whm-scroll.visible-width;
                                    max-width: whm-scroll.visible-width;
                                    preferred-width: whm-scroll.visible-width;
                                    horizontal-stretch: 0;
                                    show-label: false;
                                    max-height: self.row-height;
                                    inputs-enabled: root.inputs-enabled;
                                    text-edited(key, value) => { root.text-edited(key, value); }
                                    editing-finished(key, value) => { root.editing-finished(key, value); }
                                    toggled(key, value) => { root.toggled(key, value); }
                                    wheel(key, direction) => { root.wheel(key, direction); }
                                    text-focus(focused) => { root.focus-changed(focused); }
                                }
                            }
                        }
                    }

                    brd-scroll := ScrollView {
                        min-width: 148px;
                        max-width: 148px;
                        preferred-width: 148px;
                        horizontal-stretch: 0;
                        viewport-width: self.visible-width;
                        accessible-role: list;
                        accessible-label: "Bard Songs inputs";
                        scroll-label: self.accessible-label + " vertical scrollbar";

                        brd-content := VerticalLayout {
                            width: brd-scroll.visible-width;
                            horizontal-stretch: 0;
                            spacing: 0px;
                            for row in root.brd : Rectangle {
                                min-width: brd-scroll.visible-width;
                                max-width: brd-scroll.visible-width;
                                preferred-width: brd-scroll.visible-width;
                                horizontal-stretch: 0;
                                min-height: brd-editor.row-height;
                                max-height: brd-editor.row-height;
                                preferred-height: brd-editor.row-height;
                                vertical-stretch: 0;
                                brd-editor := ControlEditor {
                                    width: parent.width;
                                    horizontal-stretch: 0;
                                    height: parent.height;
                                    control: row;
                                    show-label: false;
                                    inputs-enabled: root.inputs-enabled;
                                    text-edited(key, value) => { root.text-edited(key, value); }
                                    editing-finished(key, value) => { root.editing-finished(key, value); }
                                    toggled(key, value) => { root.toggled(key, value); }
                                    wheel(key, direction) => { root.wheel(key, direction); }
                                    text-focus(focused) => { root.focus-changed(focused); }
                                }
                            }
                        }
                    }

                    cor-scroll := ScrollView {
                        min-width: 212px;
                        max-width: 212px;
                        preferred-width: 212px;
                        horizontal-stretch: 0;
                        viewport-width: self.visible-width;
                        accessible-role: list;
                        accessible-label: "Corsair Rolls inputs";
                        scroll-label: self.accessible-label + " vertical scrollbar";

                        cor-content := GridLayout {
                            width: cor-scroll.visible-width;
                            horizontal-stretch: 0;
                            spacing: 0px;
                            for control[index] in root.cor : ControlEditor {
                                row: index < 2 ? index : index < 10 ? floor((index - 2) / 2) + 2 : index - 4;
                                col: index >= 2 && index < 10 ? mod(index - 2, 2) : 0;
                                colspan: index >= 2 && index < 10 ? 1 : 2;
                                control: control;
                                show-label: false;
                                // Keep rank cells intact; roll selectors use the remaining lane-free width.
                                min-width: index >= 2 && index < 10 ? (mod(index, 2) == 0 ? 72px : cor-scroll.visible-width - 72px) : cor-scroll.visible-width;
                                max-width: index >= 2 && index < 10 ? (mod(index, 2) == 0 ? 72px : cor-scroll.visible-width - 72px) : cor-scroll.visible-width;
                                preferred-width: index >= 2 && index < 10 ? (mod(index, 2) == 0 ? 72px : cor-scroll.visible-width - 72px) : cor-scroll.visible-width;
                                max-height: self.row-height;
                                horizontal-stretch: 0;
                                inputs-enabled: root.inputs-enabled;
                                text-edited(key, value) => { root.text-edited(key, value); }
                                editing-finished(key, value) => { root.editing-finished(key, value); }
                                toggled(key, value) => { root.toggled(key, value); }
                                wheel(key, direction) => { root.wheel(key, direction); }
                                text-focus(focused) => { root.focus-changed(focused); }
                            }
                        }
                    }

                    geo-scroll := ScrollView {
                        min-width: 160px;
                        max-width: 160px;
                        preferred-width: 160px;
                        horizontal-stretch: 0;
                        viewport-width: self.visible-width;
                        accessible-role: list;
                        accessible-label: "Geomancy Bubbles inputs";
                        scroll-label: self.accessible-label + " vertical scrollbar";

                        geo-content := VerticalLayout {
                            width: geo-scroll.visible-width;
                            horizontal-stretch: 0;
                            spacing: 0px;
                            for row in root.geo : Rectangle {
                                min-width: geo-scroll.visible-width;
                                max-width: geo-scroll.visible-width;
                                preferred-width: geo-scroll.visible-width;
                                horizontal-stretch: 0;
                                min-height: geo-row.preferred-height;
                                max-height: geo-row.preferred-height;
                                preferred-height: geo-row.preferred-height;
                                vertical-stretch: 0;
                                geo-row := VerticalLayout {
                                    width: parent.width;
                                    height: parent.height;
                                    spacing: 0px;
                                    alignment: start;
                                    if row.key == "defaults_bubble_potency_entry" && row.visible: Text {
                                        width: geo-scroll.visible-width;
                                        text: "Bubble Potency:";
                                        color: root.inputs-enabled && row.enabled ? Palette.foreground : Palette.foreground.with-alpha(0.55);
                                    }
                                    geo-editor := ControlEditor {
                                        min-width: geo-scroll.visible-width;
                                        max-width: geo-scroll.visible-width;
                                        preferred-width: geo-scroll.visible-width;
                                        horizontal-stretch: 0;
                                        max-height: self.row-height;
                                        control: row;
                                        show-label: row.key != "defaults_bubble_potency_entry" && row.control-kind != InputWidgetKind.combo;
                                        label-width: row.control-kind == InputWidgetKind.entry ? 68px : 0px;
                                        inputs-enabled: root.inputs-enabled;
                                        text-edited(key, value) => { root.text-edited(key, value); }
                                        editing-finished(key, value) => { root.editing-finished(key, value); }
                                        toggled(key, value) => { root.toggled(key, value); }
                                        wheel(key, direction) => { root.wheel(key, direction); }
                                        text-focus(focused) => { root.focus-changed(focused); }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            GearPanel {
                source-key: "quicklook";
                equipped-width: 300px;
                min-width: 680px;
                max-width: 680px;
                preferred-width: 680px;
                horizontal-stretch: 0;
                min-height: 420px;
                max-height: 420px;
                preferred-height: 420px;
                vertical-stretch: 0;
                slots: root.equipped;
                items: root.items;
                active-slot: root.active-slot;
                inputs-enabled: root.inputs-enabled;
                slot-selected(source, slot) => { root.slot-selected(source, slot); }
                item-selected(source, id) => { root.item-selected(source, id); }

                VerticalLayout {
                    spacing: 2px;
                    min-width: 298px;
                    max-width: 298px;
                    preferred-width: 298px;
                    horizontal-stretch: 0;
                    vertical-stretch: 0;
                    GridLayout {
                        spacing: 2px;
                        min-width: 298px;
                        max-width: 298px;
                        preferred-width: 298px;
                        horizontal-stretch: 0;
                        Button {
                            row: 0;
                            col: 0;
                            text: "Copy to TP Set";
                            min-width: 148px;
                            max-width: 148px;
                            preferred-width: 148px;
                            horizontal-stretch: 0;
                            min-height: 28px;
                            max-height: 28px;
                            enabled: root.inputs-enabled;
                            clicked => { if root.inputs-enabled { root.copy("quicklook", "tp"); } }
                        }
                        Button {
                            row: 0;
                            col: 1;
                            text: "Copy to WS Set";
                            min-width: 148px;
                            max-width: 148px;
                            preferred-width: 148px;
                            horizontal-stretch: 0;
                            min-height: 28px;
                            max-height: 28px;
                            enabled: root.inputs-enabled;
                            clicked => { if root.inputs-enabled { root.copy("quicklook", "ws"); } }
                        }
                        Button {
                            row: 1;
                            col: 0;
                            colspan: 2;
                            text: "Copy Quicklook to Clipboard";
                            min-width: 298px;
                            max-width: 298px;
                            preferred-width: 298px;
                            horizontal-stretch: 0;
                            min-height: 28px;
                            max-height: 28px;
                            enabled: root.inputs-enabled;
                            clicked => { if root.inputs-enabled { root.action("export-quicklook"); } }
                        }
                        Button {
                            row: 2;
                            col: 0;
                            text: "Quicklook TP";
                            min-width: 148px;
                            max-width: 148px;
                            preferred-width: 148px;
                            horizontal-stretch: 0;
                            min-height: 28px;
                            max-height: 28px;
                            enabled: root.inputs-enabled;
                            clicked => { if root.inputs-enabled { root.action("quick-round"); } }
                        }
                        Button {
                            row: 2;
                            col: 1;
                            text: "Quicklook WS";
                            min-width: 148px;
                            max-width: 148px;
                            preferred-width: 148px;
                            horizontal-stretch: 0;
                            min-height: 28px;
                            max-height: 28px;
                            enabled: root.inputs-enabled;
                            clicked => { if root.inputs-enabled { root.action("quick-ws"); } }
                        }
                        Button {
                            row: 3;
                            col: 0;
                            text: "Quicklook Spell";
                            min-width: 148px;
                            max-width: 148px;
                            preferred-width: 148px;
                            horizontal-stretch: 0;
                            min-height: 28px;
                            max-height: 28px;
                            enabled: root.inputs-enabled;
                            clicked => { if root.inputs-enabled { root.action("quick-spell"); } }
                        }
                        Button {
                            row: 3;
                            col: 1;
                            text: "Simulate WS";
                            min-width: 148px;
                            max-width: 148px;
                            preferred-width: 148px;
                            horizontal-stretch: 0;
                            min-height: 28px;
                            max-height: 28px;
                            enabled: root.inputs-enabled;
                            clicked => { if root.inputs-enabled { root.action("single-ws"); } }
                        }
                    }
                    GridLayout {
                        spacing: 0px;
                        min-width: 298px;
                        max-width: 298px;
                        preferred-width: 298px;
                        horizontal-stretch: 0;
                        Text {
                            row: 0;
                            col: 0;
                            text: root.damage;
                            min-width: 298px;
                            max-width: 298px;
                            preferred-width: 298px;
                            horizontal-stretch: 0;
                            color: Palette.foreground;
                            preferred-height: 18px;
                            accessible-label: "Average damage";
                            accessible-value: root.damage;
                        }
                        Text {
                            row: 1;
                            col: 0;
                            text: root.tp-return;
                            min-width: 298px;
                            max-width: 298px;
                            preferred-width: 298px;
                            horizontal-stretch: 0;
                            color: Palette.foreground;
                            preferred-height: 18px;
                            accessible-label: "Average TP";
                            accessible-value: root.tp-return;
                        }
                        Text {
                            row: 2;
                            col: 0;
                            text: root.time-to-ws;
                            min-width: 298px;
                            max-width: 298px;
                            preferred-width: 298px;
                            horizontal-stretch: 0;
                            color: Palette.foreground;
                            preferred-height: 18px;
                            accessible-label: "Time per WS";
                            accessible-value: root.time-to-ws;
                        }
                    }
                }
            }
        }
    }
}
