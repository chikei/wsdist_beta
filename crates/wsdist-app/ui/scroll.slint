import { Palette, ScrollView as NativeScrollView, TextEdit as NativeTextEdit } from "std-widgets.slint";

export component VerticalScrollBar inherits Rectangle {
    in property <bool> enabled: true;
    in property <string> scroll-label: "Vertical scroll";
    in property <length> viewport-height;
    in property <length> visible-height;
    in-out property <length> value;
    out property <length> maximum: max(0px, root.viewport-height - root.visible-height);
    out property <bool> has-overflow: root.visible-height > 0px && root.maximum > 0px;
    private property <length> track-height: max(0px, root.height);
    private property <length> thumb-height: root.has-overflow
        ? min(root.track-height, max(32px, root.track-height * root.visible-height / max(1px, root.viewport-height)))
        : 0px;
    private property <length> thumb-travel: max(0px, root.track-height - root.thumb-height);
    private property <bool> dragging: false;
    callback scrolled();

    width: 18px;
    visible: root.has-overflow && root.width > 0px && root.height > 0px;
    accessible-role: slider;
    accessible-label: root.scroll-label;
    accessible-enabled: root.enabled && root.has-overflow;
    accessible-value: max(0px, min(root.maximum, -root.value)) / 1px;
    accessible-value-minimum: 0;
    accessible-value-maximum: root.maximum / 1px;
    accessible-value-step: min(10, root.maximum / 1px);
    accessible-action-set-value(v) => {
        if v.is-float() { root.set-value(-v.to-float() * 1px); }
    }
    accessible-action-increment => { root.set-value(root.value - 10px); }
    accessible-action-decrement => { root.set-value(root.value + 10px); }

    function constrain-value() {
        let clamped-value = root.has-overflow ? max(-root.maximum, min(0px, root.value)) : 0px;
        // A no-op set on the aliased viewport cancels Slint's native wheel animation.
        if clamped-value != root.value { root.value = clamped-value; }
        if !root.has-overflow { root.dragging = false; }
    }

    function set-value(new-value: length) {
        if !root.enabled || !root.has-overflow { return; }
        root.value = max(-root.maximum, min(0px, new-value));
        root.scrolled();
    }

    changed value => { root.constrain-value(); }
    // Virtual ListView extent estimates can change mid-drag; rebase rather than jump.
    changed viewport-height => {
        root.constrain-value();
        interaction.rebase-drag();
    }
    changed visible-height => {
        root.constrain-value();
        interaction.rebase-drag();
    }
    changed height => { interaction.rebase-drag(); }
    changed enabled => { if !root.enabled { root.dragging = false; } }

    track := Rectangle {
        width: root.width;
        height: root.height;
        background: Palette.background;
        border-width: 1px;
        border-color: Palette.foreground;
        border-radius: 3px;
    }

    thumb := Rectangle {
        width: 14px;
        height: root.thumb-height;
        x: (root.width - self.width) / 2;
        y: root.maximum > 0px ? root.thumb-travel * max(0, min(1, -root.value / root.maximum)) : 0px;
        background: Palette.foreground;
        border-radius: 3px;
        visible: root.has-overflow;
    }

    interaction := TouchArea {
        enabled: root.enabled && root.has-overflow;
        private property <length> saved-value;
        private property <length> saved-y;
        private property <length> saved-maximum;
        private property <length> saved-travel;

        function rebase-drag() {
            if root.dragging {
                self.saved-value = root.value;
                self.saved-y = self.mouse-y;
                self.saved-maximum = root.maximum;
                self.saved-travel = root.thumb-travel;
            }
        }

        pointer-event(event) => {
            if event.kind == PointerEventKind.cancel || event.kind == PointerEventKind.up {
                root.dragging = false;
                return;
            }
            if event.button != PointerEventButton.left || event.kind != PointerEventKind.down || !self.enabled { return; }
            root.dragging = self.mouse-y >= thumb.y && self.mouse-y <= thumb.y + thumb.height;
            if root.dragging {
                self.rebase-drag();
            } else {
                root.set-value(root.value + (self.mouse-y < thumb.y ? root.visible-height : -root.visible-height));
            }
        }

        moved => {
            if self.enabled && self.pressed && root.dragging {
                if self.saved-maximum != root.maximum || self.saved-travel != root.thumb-travel {
                    self.rebase-drag();
                }
                if root.thumb-travel > 0px {
                    root.set-value(self.saved-value - (self.mouse-y - self.saved-y) * root.maximum / root.thumb-travel);
                }
            }
        }

        scroll-event(event) => {
            if self.enabled && event.delta-y != 0px {
                root.set-value(root.value + event.delta-y);
                return accept;
            }
            return reject;
        }
    }
}

export component ScrollView inherits Rectangle {
    in property <bool> enabled: true;
    in property <string> scroll-label: "Vertical scroll";
    out property <length> visible-width <=> native-view.visible-width;
    out property <length> visible-height <=> native-view.visible-height;
    in-out property <length> viewport-width <=> native-view.viewport-width;
    in-out property <length> viewport-height <=> native-view.viewport-height;
    in-out property <length> viewport-x <=> native-view.viewport-x;
    in-out property <length> viewport-y <=> native-view.viewport-y;
    in-out property <bool> has-focus <=> native-view.has-focus;
    in property <bool> mouse-drag-pan-enabled <=> native-view.mouse-drag-pan-enabled;
    callback scrolled <=> native-view.scrolled;

    min-height: 50px;
    min-width: 50px;
    horizontal-stretch: 1;
    vertical-stretch: 1;
    preferred-height: 100%;
    preferred-width: 100%;

    // Reserve the lane even when content fits, so wrapped controls do not resize on overflow.
    // Slint otherwise centers this narrower child, shifting content and overlapping the lane.
    native-view := NativeScrollView {
        x: 0px;
        y: 0px;
        width: max(0px, root.width - 18px);
        height: root.height;
        enabled: root.enabled;
        vertical-scrollbar-policy: always-off;
        @children
    }

    vertical-bar := VerticalScrollBar {
        x: native-view.x + native-view.width;
        y: native-view.y;
        height: root.visible-height;
        enabled: root.enabled;
        scroll-label: root.scroll-label;
        viewport-height: root.viewport-height;
        visible-height: root.visible-height;
        value <=> root.viewport-y;
        scrolled => { root.scrolled(); }
    }
}

// Keep this name and direct repeated delegates: Slint recognizes ListView virtualization by type name.
export component ListView inherits ScrollView {
    @children
    accessible-role: list;
}

export component ScrollableTextEdit inherits Rectangle {
    in property <string> scroll-label: "Vertical scroll";
    in property <TextWrap> wrap <=> editor.wrap;
    in property <TextHorizontalAlignment> horizontal-alignment <=> editor.horizontal-alignment;
    in property <bool> read-only <=> editor.read-only;
    in property <length> font-size <=> editor.font-size;
    in property <string> font-family <=> editor.font-family;
    in property <bool> font-italic <=> editor.font-italic;
    in property <bool> enabled <=> editor.enabled;
    in property <string> placeholder-text <=> editor.placeholder-text;
    out property <bool> has-focus: editor.has-focus;
    out property <length> visible-width <=> editor.visible-width;
    out property <length> visible-height <=> editor.visible-height;
    in-out property <string> text <=> editor.text;
    in-out property <length> viewport-x <=> editor.viewport-x;
    in-out property <length> viewport-y <=> editor.viewport-y;
    in-out property <length> viewport-width <=> editor.viewport-width;
    in-out property <length> viewport-height <=> editor.viewport-height;
    callback edited <=> editor.edited;
    callback key-pressed <=> editor.key-pressed;
    callback key-released <=> editor.key-released;

    forward-focus: editor;
    horizontal-stretch: 1;
    vertical-stretch: 1;
    min-width: editor.min-width;
    min-height: editor.min-height;
    preferred-width: editor.preferred-width;
    preferred-height: editor.preferred-height;
    accessible-role: text-input;
    accessible-enabled: root.enabled;
    accessible-value <=> root.text;
    accessible-placeholder-text: root.placeholder-text;
    accessible-read-only: root.read-only;

    public function set-selection-offsets(start: int, end: int) {
        editor.set-selection-offsets(start, end);
    }
    public function select-all() { editor.select-all(); }
    public function clear-selection() { editor.clear-selection(); }
    public function cut() { editor.cut(); }
    public function copy() { editor.copy(); }
    public function paste() { editor.paste(); }

    editor := NativeTextEdit {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        accessible-role: none;
        // Fluent uses 12px padding; keep native input/selection and narrow only its text viewport.
        viewport-width: max(0px, self.visible-width - 18px);
    }

    // A sibling is necessary: std TextEdit does not expose its internal children slot.
    // The opaque lane covers its native 14px scrollbar without replacing the text widget.
    vertical-bar := VerticalScrollBar {
        x: max(0px, root.width - 12px - 18px);
        y: 12px;
        height: root.visible-height;
        enabled: root.enabled;
        scroll-label: root.scroll-label;
        viewport-height: root.viewport-height;
        visible-height: root.visible-height;
        value <=> root.viewport-y;
    }
}
