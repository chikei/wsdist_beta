import { Button, GroupBox, Palette } from "std-widgets.slint";
import { ScrollView } from "scroll.slint";
import { StatDisplayRow } from "types.slint";

component StatGroup inherits GroupBox {
    in property <[StatDisplayRow]> rows;
    in property <length> group-width;
    in property <length> value-width: 64px;
    private property <length> label-width: root.group-width - root.value-width - 10px;

    content-padding: 0px;
    width: root.group-width;
    horizontal-stretch: 0;

    preferred-height: 32px + rows-layout.preferred-height;
    vertical-stretch: 0;

    rows-layout := VerticalLayout {
        width: root.group-width;
        horizontal-stretch: 0;
        spacing: 0px;
        alignment: start;
        vertical-stretch: 1;
        for row in root.rows: Rectangle {
            private property <length> row-height: max(24px, max(stat-label.preferred-height, stat-value.preferred-height) + 4px);
            width: root.group-width;
            horizontal-stretch: 0;
            min-height: self.row-height;
            max-height: self.row-height;
            preferred-height: self.row-height;
            vertical-stretch: 0;
            accessible-role: list-item;
            accessible-label: row.label + ": " + row.value;

            HorizontalLayout {
                width: root.group-width;
                horizontal-stretch: 0;
                padding-left: 2px;
                padding-right: 2px;
                padding-top: 2px;
                padding-bottom: 2px;
                spacing: 6px;

                stat-label := Text {
                    text: row.label;
                    color: Palette.foreground;
                    font-size: 12px;
                    wrap: word-wrap;
                    vertical-alignment: center;
                    width: root.label-width;
                    horizontal-stretch: 0;
                }
                stat-value := Text {
                    text: row.value;
                    color: Palette.foreground;
                    font-size: 12px;
                    font-weight: 500;
                    wrap: word-wrap;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                    width: root.value-width;
                    horizontal-stretch: 0;
                    accessible-label: row.label;
                    accessible-value: row.value;
                }
            }
        }
    }
}

export component Stats inherits Rectangle {
    in property <[StatDisplayRow]> base;
    in property <[StatDisplayRow]> physical;
    in property <[StatDisplayRow]> magical;
    in property <[StatDisplayRow]> multi;
    in property <[StatDisplayRow]> haste;
    in property <[StatDisplayRow]> defensive;
    in property <[StatDisplayRow]> other;
    in property <string> source-label;
    in property <bool> inputs-enabled: true;

    callback action(string);

    ScrollView {
        viewport-width: self.visible-width;
        accessible-role: list;
        accessible-label: "Stats content";
        scroll-label: self.accessible-label + " vertical scrollbar";

        VerticalLayout {
            x: 0px;
            width: 692px;
            horizontal-stretch: 0;
            padding-left: 6px;
            padding-right: 6px;
            padding-top: 2px;
            padding-bottom: 2px;
            spacing: 2px;

            HorizontalLayout {
                min-width: 680px;
                max-width: 680px;
                preferred-width: 680px;
                horizontal-stretch: 0;
                spacing: 4px;
                vertical-stretch: 0;
                Button {
                    text: "Quicklook Gear Stats";
                    enabled: root.inputs-enabled;
                    min-height: 28px;
                    preferred-height: 28px;
                    min-width: 224px;
                    max-width: 224px;
                    preferred-width: 224px;
                    horizontal-stretch: 0;
                    clicked => { root.action("stats-quicklook"); }
                }
                Button {
                    text: "TP Gear Stats";
                    enabled: root.inputs-enabled;
                    min-height: 28px;
                    preferred-height: 28px;
                    min-width: 224px;
                    max-width: 224px;
                    preferred-width: 224px;
                    horizontal-stretch: 0;
                    clicked => { root.action("stats-tp"); }
                }
                Button {
                    text: "WS Gear Stats";
                    enabled: root.inputs-enabled;
                    min-height: 28px;
                    preferred-height: 28px;
                    min-width: 224px;
                    max-width: 224px;
                    preferred-width: 224px;
                    horizontal-stretch: 0;
                    clicked => { root.action("stats-ws"); }
                }
            }

            Text {
                min-width: 680px;
                max-width: 680px;
                preferred-width: 680px;
                horizontal-stretch: 0;
                text: "Displayed source: " + root.source-label;
                color: Palette.foreground;
                wrap: word-wrap;
                vertical-stretch: 0;
                accessible-label: "Displayed player stats source";
                accessible-value: root.source-label;
            }

            HorizontalLayout {
                min-width: 680px;
                max-width: 680px;
                preferred-width: 680px;
                horizontal-stretch: 0;
                alignment: start;
                spacing: 6px;
                vertical-stretch: 0;
                StatGroup {
                    title: "Base Parameters";
                    rows: root.base;
                    value-width: 48px;
                    group-width: 120px;
                }
                StatGroup {
                    title: "Physical";
                    rows: root.physical;
                    group-width: 230px;
                }
                StatGroup {
                    title: "Magical";
                    rows: root.magical;
                    group-width: 270px;
                }
            }

            HorizontalLayout {
                min-width: 680px;
                max-width: 680px;
                preferred-width: 680px;
                horizontal-stretch: 0;
                alignment: start;
                spacing: 6px;
                vertical-stretch: 0;
                StatGroup {
                    title: "Multi-Attack";
                    rows: root.multi;
                    group-width: 220px;
                }
                StatGroup {
                    title: "Attack Speed";
                    rows: root.haste;
                    group-width: 260px;
                }
            }

            HorizontalLayout {
                min-width: 680px;
                max-width: 680px;
                preferred-width: 680px;
                horizontal-stretch: 0;
                alignment: start;
                spacing: 6px;
                vertical-stretch: 0;
                StatGroup {
                    title: "Defensive";
                    rows: root.defensive;
                    group-width: 230px;
                }
                StatGroup {
                    title: "Other Stats";
                    rows: root.other;
                    group-width: 310px;
                }
            }
        }
    }
}
