import { CheckBox, GroupBox, LineEdit, Palette } from "std-widgets.slint";
import { CompactComboBox } from "combobox.slint";
import { ScrollView } from "scroll.slint";
import { InputRow, InputWidgetKind } from "types.slint";

component EntryControl inherits LineEdit {
    in property <InputRow> control;
    in property <bool> inputs-enabled;
    callback text-edited(string, string);
    callback editing-finished(string, string);
    callback text-focus(bool);
    private property <bool> dirty: false;
    private property <bool> editing-focus: root.enabled && root.has-focus;
    enabled: root.inputs-enabled && root.control.enabled && root.control.visible;
    text: root.control.text;
    accessible-label: root.control.label;
    accessible-description: root.control.tooltip;
    accessible-id: root.control.key;
    changed control => { root.text = root.control.text; }
    changed editing-focus => { root.text-focus(root.editing-focus); }
    edited(value) => {
        if root.enabled {
            root.dirty = true;
            root.text-edited(root.control.key, value);
        }
    }
    accepted(value) => {
        if root.enabled {
            root.dirty = false;
            root.editing-finished(root.control.key, value);
        }
    }
    changed has-focus => {
        if !root.has-focus && root.dirty {
            root.dirty = false;
            if root.enabled { root.editing-finished(root.control.key, root.text); }
        }
    }
}

component ComboControl inherits CompactComboBox {
    in property <InputRow> control;
    in property <bool> inputs-enabled;
    callback text-edited(string, string);
    callback text-focus(bool);
    private property <bool> editing-focus: root.enabled && root.has-focus;
    enabled: root.inputs-enabled && root.control.enabled && root.control.visible;
    model: root.control.choices;
    current-index: root.control.selection;
    current-value: root.control.text;
    accessible-label: root.control.label;
    accessible-description: root.control.tooltip;
    accessible-value: root.control.text;
    accessible-id: root.control.key;
    changed control => {
        root.current-index = root.control.selection;
        root.current-value = root.control.text;
    }
    changed editing-focus => { root.text-focus(root.editing-focus); }
    // A native model reset must not erase an unlisted restored value.
    changed current-value => {
        if root.control.selection < 0 && root.current-value != root.control.text {
            root.current-value = root.control.text;
        }
    }
    selected(value) => {
        if root.enabled { root.text-edited(root.control.key, value); }
    }
}

component CheckControl inherits CheckBox {
    in property <InputRow> control;
    in property <bool> inputs-enabled;
    callback control-toggled(string, bool);
    enabled: root.inputs-enabled && root.control.enabled && root.control.visible;
    text: root.control.label;
    checked: root.control.checked;
    accessible-label: root.control.label;
    accessible-description: root.control.tooltip;
    accessible-id: root.control.key;
    changed control => { root.checked = root.control.checked; }
    toggled => {
        if root.enabled { root.control-toggled(root.control.key, root.checked); }
    }
}

export component ControlEditor inherits Rectangle {
    in property <InputRow> control;
    in property <bool> inputs-enabled: true;
    in property <bool> show-label: true;
    in property <string> display-label: root.control.label;
    in property <length> label-width: 100px;
    in property <length> editor-height: 20px;
    callback text-edited(string, string);
    callback editing-finished(string, string);
    callback toggled(string, bool);
    callback wheel(string, int);
    callback text-focus(bool);

    private property <bool> editable: root.inputs-enabled && root.control.enabled && root.control.visible;
    private property <bool> has-label: root.show-label && root.control.control-kind != InputWidgetKind.checkbox;
    private property <length> editor-width: max(0px, root.width - (root.has-label ? root.label-width + 2px : 0px));
    out property <length> row-height: root.control.visible ? root.editor-height : 0px;
    visible: root.control.visible;
    min-width: 84px;
    preferred-width: 84px;
    min-height: root.row-height;
    preferred-height: root.row-height;
    vertical-stretch: 0;

    TouchArea {
        width: root.width;
        height: root.height;
        enabled: root.control.visible;
        scroll-event(event) => {
            if root.editable && root.control.control-kind == InputWidgetKind.entry {
                if event.delta-y > 0px { root.wheel(root.control.key, 1); return accept; }
                if event.delta-y < 0px { root.wheel(root.control.key, -1); return accept; }
            }
            return reject;
        }
        // Only the active widget participates in sizing. Invisible overlapping
        // grid children still impose constraints and can stretch a compact row.
        HorizontalLayout {
            width: parent.width;
            height: root.editor-height;
            y: 0px;
            spacing: 2px;
            if root.has-label: Text {
                text: root.display-label;
                min-width: root.label-width;
                max-width: root.label-width;
                color: root.editable || root.control.control-kind == InputWidgetKind.label ? Palette.foreground : Palette.foreground.with-alpha(0.55);
                vertical-alignment: center;
                wrap: word-wrap;
                accessible-role: none;
            }
            if root.control.control-kind == InputWidgetKind.entry: EntryControl {
                control: root.control;
                inputs-enabled: root.inputs-enabled;
                min-width: root.editor-width;
                preferred-width: root.editor-width;
                max-width: root.editor-width;
                min-height: root.editor-height;
                max-height: root.editor-height;
                horizontal-stretch: 0;
                text-edited(key, value) => { root.text-edited(key, value); }
                editing-finished(key, value) => { root.editing-finished(key, value); }
                text-focus(focused) => { root.text-focus(focused); }
            }
            if root.control.control-kind == InputWidgetKind.combo: ComboControl {
                control: root.control;
                inputs-enabled: root.inputs-enabled;
                min-width: root.editor-width;
                preferred-width: root.editor-width;
                max-width: root.editor-width;
                min-height: root.editor-height;
                max-height: root.editor-height;
                horizontal-stretch: 0;
                text-edited(key, value) => { root.text-edited(key, value); }
                text-focus(focused) => { root.text-focus(focused); }
            }
            if root.control.control-kind == InputWidgetKind.checkbox: CheckControl {
                control: root.control;
                inputs-enabled: root.inputs-enabled;
                min-width: root.editor-width;
                preferred-width: root.editor-width;
                max-width: root.editor-width;
                min-height: root.editor-height;
                max-height: root.editor-height;
                horizontal-stretch: 0;
                control-toggled(key, checked) => { root.toggled(key, checked); }
            }
            if root.control.control-kind == InputWidgetKind.label: Text {
                min-width: root.editor-width;
                max-width: root.editor-width;
                text: root.control.text;
                color: Palette.foreground;
                wrap: word-wrap;
                vertical-alignment: center;
                horizontal-stretch: 0;
                accessible-label: root.control.label;
            }
        }
    }
}

export component InputGroup inherits GroupBox {
    in property <[InputRow]> rows;
    in property <bool> inputs-enabled: true;
    in property <bool> show-label: true;
    callback text-edited(string, string);
    callback editing-finished(string, string);
    callback toggled(string, bool);
    callback wheel(string, int);
    callback text-focus(bool);

    min-width: 100px;
    content-padding: 0px;
    min-height: min(100px, self.preferred-height);
    preferred-height: 220px;
    vertical-stretch: 1;

    private property <int> focus-count: 0;
    private property <bool> editing-focus: root.inputs-enabled && root.visible && root.focus-count > 0;
    changed editing-focus => { root.text-focus(root.editing-focus); }

    rows-view := ScrollView {
        min-height: 24px;
        viewport-width: self.visible-width;
        accessible-role: list;
        accessible-label: root.title + " inputs";
        scroll-label: self.accessible-label + " vertical scrollbar";
        // Scalar groups are small and contain variable-height/hidden controls.
        // A real column gives the scrollbar an exact end; gear lists stay virtual.
        VerticalLayout {
            spacing: 0px;
            width: rows-view.visible-width;
            for row in root.rows : Rectangle {
                min-height: editor.row-height;
                max-height: editor.row-height;
                preferred-height: editor.row-height;
                vertical-stretch: 0;
                editor := ControlEditor {
                    width: parent.width;
                    height: parent.height;
                    control: row;
                    inputs-enabled: root.inputs-enabled;
                    show-label: root.show-label;
                    text-edited(key, value) => { root.text-edited(key, value); }
                    editing-finished(key, value) => { root.editing-finished(key, value); }
                    toggled(key, value) => { root.toggled(key, value); }
                    wheel(key, direction) => { root.wheel(key, direction); }
                    text-focus(focused) => {
                        root.focus-count = max(0, root.focus-count + (focused ? 1 : -1));
                    }
                }
            }
        }
    }
}
